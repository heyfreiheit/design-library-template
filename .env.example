# Vercel > Storage > Neon (Postgres), pooled connection string with sslmode=require
DATABASE_URL=
# Vercel > Storage > Blob > Private, connected to your project
BLOB_READ_WRITE_TOKEN=
# Generate both locally with: node scripts/setup-secrets.mjs
VAULT_ENCRYPTION_KEY=
SETUP_TOKEN=
# Optional: exact final origin; otherwise request origin is used (also supports preview deployments)
APP_ORIGIN=
